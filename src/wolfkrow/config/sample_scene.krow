deadline:
  host_name: deadline-manager
  port: 8082
  default_group: 8cores
  default_pool: bundle
  default_limits: 
  default_limit_groups:

  task_overrides:
    NukeRender:
      limit_groups: [nuke]

  extra_job_attributes:
    ExtraInfo0: "$SHOW"
    ExtraInfo1: "$WORKSPACE"
    ExtraInfo2: "$WORKSPACE_PATH"
    UserName: "$USER"


  environment_inclusion_filters:
    - TK_* # Toolkit environment variables
    - "*OCIO*" # Include everything relating to ocio
    - WOLFKROW* # Wolfkrow environment variables
  environment_exclusion_filters:
  environment_inclusion_list:
    - PYTHONPATH
    - PATH
  environment_exclusion_list:

nuke_submitter:
  # NOTE: $TEMP here will typically be a local drive. This will need to change to 
  # a location accessible by your farm machines if submitting jobs to Deadline.
  temp_dir: "$TEMP/wolfkrow_temp"

  
wolfkrow:
  host: localhost
  user: wolfkrow
  password: Gpb3s4bm

  wolfkrow_config_search_paths:
    site:
      path: D:/wolfkrow_v2/_wolfkrow/wolfkrow.yaml
      children:
        show: 
          path: D:/wolfkrow_v2/shows/$SHOW/_wolfkrow/wolfkrow.yaml
          children:
            episode: 
              path: D:/wolfkrow_v2/shows/$SHOW/_episodes/$EPISODE/_wolfkrow/wolfkrow.yaml
            sequence: 
              path: D:/wolfkrow_v2/shows/$SHOW/_shots/$SEQUENCE/_wolfkrow/wolfkrow.yaml
              children:
                shot: 
                  path: D:/wolfkrow_v2/shows/$SHOW/_shots/$SEQUENCE/$SHOT/_wolfkrow/wolfkrow.yaml
